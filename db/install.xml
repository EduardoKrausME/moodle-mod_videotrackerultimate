<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/videotrackerultimate/db" VERSION="20261006" COMMENT="XMLDB file for Video Tracker Ultimate."
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="videotrackerultimate" COMMENT="Video Tracker Ultimate activities.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="videosource" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="sourceconfig" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="videourl" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="usegrade" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="grademax" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="100" SEQUENCE="false"/>
                <FIELD NAME="excellentmin" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="85" SEQUENCE="false"/>
                <FIELD NAME="adequatemin" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="70" SEQUENCE="false"/>
                <FIELD NAME="attentionmin" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="50" SEQUENCE="false"/>
                <FIELD NAME="excellentlabel" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="Excelente" SEQUENCE="false"/>
                <FIELD NAME="adequatelabel" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="Adequado" SEQUENCE="false"/>
                <FIELD NAME="attentionlabel" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="Atenção" SEQUENCE="false"/>
                <FIELD NAME="insufficientlabel" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="Insuficiente" SEQUENCE="false"/>
                <FIELD NAME="reviewthreshold" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="70" SEQUENCE="false"/>
                <FIELD NAME="rankingenabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="completionminscore" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="completionminpercent" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="completionindicators" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="course_fk" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="videotrackerultimate_ind" COMMENT="Configured explainable score indicators.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="ultimateid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="ruletype" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="weight" TYPE="number" LENGTH="8" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="limitvalue" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="configjson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="requiredcompletion" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="ultimate_fk" TYPE="foreign" FIELDS="ultimateid" REFTABLE="videotrackerultimate" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="ultimate_sort" UNIQUE="false" FIELDS="ultimateid, sortorder"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="videotrackerultimate_score" COMMENT="Cached normalized metrics and explainable scores.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="ultimateid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="rawscore" TYPE="number" LENGTH="8" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="totalweight" TYPE="number" LENGTH="8" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="score" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="statuscode" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="metricsjson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="breakdownjson" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="calculatedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="origin" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timecalculated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="gradeupdated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="gradeorigin" TYPE="char" LENGTH="40" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="ultimate_fk" TYPE="foreign" FIELDS="ultimateid" REFTABLE="videotrackerultimate" REFFIELDS="id"/>
                <KEY NAME="user_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="ultimate_user" UNIQUE="true" FIELDS="ultimateid, userid"/>
                <INDEX NAME="ultimate_score" UNIQUE="false" FIELDS="ultimateid, score"/>
                <INDEX NAME="calculated" UNIQUE="false" FIELDS="timecalculated"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="videotrackerultimate_log" COMMENT="Audit log of score recalculations.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="ultimateid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="triggeredby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="origin" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="oldscore" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="newscore" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="ultimate_fk" TYPE="foreign" FIELDS="ultimateid" REFTABLE="videotrackerultimate" REFFIELDS="id"/>
                <KEY NAME="user_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="ultimate_user_time" UNIQUE="false" FIELDS="ultimateid, userid, timecreated"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
